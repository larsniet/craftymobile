# crafty-push configuration. Copy to ".env" and fill in.

# --- Crafty Controller ---
CRAFTY_URL=https://crafty.example.com:8443
CRAFTY_TOKEN=your-crafty-api-token
# Accept Crafty's self-signed certificate (true for most self-hosted setups).
CRAFTY_ALLOW_SELF_SIGNED=true

# --- Apple Push Notifications (APNs) ---
# Create an APNs Auth Key (.p8) at developer.apple.com → Certificates,
# Identifiers & Profiles → Keys → (+) → Apple Push Notifications service.
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=3BGHPQ6C3H
APNS_BUNDLE_ID=com.larsniet.CraftyMobile
# Sideloaded/Xcode (development) builds use the APNs SANDBOX. Use "production"
# only for a TestFlight/App Store build.
APNS_ENV=sandbox

# --- Server ---
PORT=8099
# How often to poll Crafty (seconds).
POLL_INTERVAL_SECONDS=30
# Minimum seconds between silent (non-status-change) refresh pushes. Apple
# throttles background pushes, so keep this at a few minutes.
SILENT_PUSH_MIN_SECONDS=300
# Where to persist registered device tokens.
TOKENS_FILE=./tokens.json
